# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5001

# AI Gateway (Primary Model Provider for GPT, Claude, Gemini, Qwen, DeepSeek, etc.)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAX_OUTPUT_TOKENS=4096

# Dedicated Mahi Engine API Provider (Completely Separate from OpenRouter)
MAHI_ENGINE_API_KEY=
MAHI_ENGINE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MAHI_ENGINE_MODEL=gemini-3.5-flash
MAHI_ENGINE_MAX_OUTPUT_TOKENS=4096
MAHI_ENGINE_TIMEOUT_MS=60000

# Search & Research Grounding (Optional)
TAVILY_API_KEY=

# Image Generation Provider (Optional)
FAL_KEY=

# Supabase PostgreSQL Storage (Optional in Dev, persistent in Prod)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis Cloud Cache & Distributed Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Operational Limits & Timeouts (Optional)
STREAM_TIMEOUT_MS=60000
SEARCH_TIMEOUT_MS=12000
IMAGE_TIMEOUT_MS=25000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_CHAT=45
RATE_LIMIT_MAX_GENERAL=120
